# Copy to .env for local runs (node --env-file=.env publisher/publish.mjs). In GitHub, add the
# *_TOKEN values as repository Secrets and the rest as repository Variables.

# Public base URL serving this repo's files (Instagram fetches images from here)
PUBLIC_ASSET_BASE_URL=https://<user>.github.io/agency

# Meta (Facebook Page + Instagram)
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=
# META_GRAPH_VERSION=v23.0

# LinkedIn Company Page
LINKEDIN_ORG_ID=
LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_VERSION=202608

# X
X_ACCESS_TOKEN=
